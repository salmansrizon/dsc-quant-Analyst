# Telegram SDLC control channel — copy to .env (gitignored) and fill in.
# The .env file must NEVER be committed.

# A FRESH token from @BotFather. If any token was pasted into a shared file or
# chat, revoke it (/revoke in BotFather) and mint a new one — treat the old as public.
TELEGRAM_BOT_TOKEN=

# Owner numeric chat id. Get it: message your bot, then run
#   source scripts/telegram-env.sh && curl -s "$API/getUpdates" | jq '.result[-1].message.chat.id'
# Inbound commands are allow-listed to exactly this id.
TELEGRAM_CHAT_ID=

# Shared secret every command must carry as its first argument
# (e.g. "/run <secret> add login"). Defence in depth beyond the token.
TELEGRAM_CMD_SECRET=
